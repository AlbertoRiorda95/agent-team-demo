# Copy to .env (git-ignored) for local runs. Placeholders only: never commit real values.
# docker compose reads .env automatically.

# Postgres used by services/orders (compose sets its own for the container).
DATABASE_URL=postgres://orders:orders@localhost:5432/orders
PORT=3000

# Origin of the web app (scheme://host[:port], no path). State-changing staff
# requests must send this Origin. Default outside production: http://localhost:5173.
# Required when NODE_ENV=production.
PUBLIC_ORIGIN=http://localhost:5173

# Key of the HMAC that stores session tokens: at least 32 characters, random.
# Required by `docker compose up` (the orders image runs with NODE_ENV=production).
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=
