# ci/registry.env: this project's packages (ci/registry.sh). Not secret:
# tokens never go in this file or any committed file.
# Orders: the package is packages/money (@albertoriorda95/money), a standalone
# npm project published to GitHub Packages. It is not at the repository root,
# so the npm commands run on packages/money (REGISTRY_KIND=custom).

# the package manager:
#   npm | pypi | maven | gradle | conan   handled by ci/registry.sh
#   custom                                any other one: the commands below
#   none                                  login, publish and local do nothing
REGISTRY_KIND=custom
# the team's registry; empty: no registry (login does nothing, publish fails:
# use ./ci/registry.sh local). For example
#   https://npm.pkg.github.com/                                   (GitHub Packages, npm)
#   https://gitlab.example.com/api/v4/projects/<id>/packages/npm/  (GitLab, npm)
#   https://pypi.example.com/simple/  and its upload URL in REGISTRY_UPLOAD_URL (pypi)
#   https://maven.pkg.github.com/<owner>/<repo>                   (GitHub Packages, maven, gradle)
#   https://gitlab.example.com/api/v4/projects/<id>/packages/conan (GitLab, conan)
#   https://artifactory.example.com/artifactory/api/conan/<repo>  (Artifactory, conan)
REGISTRY_URL=https://npm.pkg.github.com/
REGISTRY_UPLOAD_URL=
# npm: the scope served by the registry (@org); empty: the registry serves everything
REGISTRY_SCOPE=@albertoriorda95
# maven: the <server> id of pom.xml; gradle: the repository name in build.gradle;
# conan: the remote's name
REGISTRY_ID=team
# the user that goes with the token; empty: a default that fits the token
# (gitlab-ci-token for CI_JOB_TOKEN, x-access-token for GITHUB_TOKEN)
REGISTRY_USER=

# yes: this project is itself a package: the release job publishes it on a v* tag,
# ./ci/registry.sh local installs it on this machine
PUBLISH_PACKAGE=yes
# npm and pypi, local: where the .tgz and the wheels go (empty: ~/.local/share/packages);
# maven, gradle and conan use their own local repository (~/.m2, Conan's cache)
LOCAL_REPOSITORY=

# custom: run with bash, the token in $REGISTRY_AUTH_TOKEN and the user in
# $REGISTRY_AUTH_USER; never echo them. For example, cargo:
#   LOGIN_COMMAND='printf "[registries.team]\ntoken = \"Bearer %s\"\n" "$REGISTRY_AUTH_TOKEN" > ~/.cargo/credentials.toml'
#   PUBLISH_COMMAND='cargo publish --registry team'
#   LOCAL_COMMAND='cargo install --path .'
# npm in a subfolder: the scope's registry and the token go only in the user's ~/.npmrc
LOGIN_COMMAND='npm config set --location=user "@albertoriorda95:registry" "https://npm.pkg.github.com/" && npm config set --location=user "//npm.pkg.github.com/:_authToken" "$REGISTRY_AUTH_TOKEN"'
PUBLISH_COMMAND='npm config set --location=user "@albertoriorda95:registry" "https://npm.pkg.github.com/" && npm config set --location=user "//npm.pkg.github.com/:_authToken" "$REGISTRY_AUTH_TOKEN" && npm --prefix packages/money run build --if-present && npm publish ./packages/money --registry https://npm.pkg.github.com/'
LOCAL_COMMAND='mkdir -p "${LOCAL_REPOSITORY:-$HOME/.local/share/packages}" && npm --prefix packages/money run build --if-present && npm pack ./packages/money --pack-destination "${LOCAL_REPOSITORY:-$HOME/.local/share/packages}"'
